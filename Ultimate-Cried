-- PREDICT WRAPPER
-- ============================================================
local function predictPosition(targetPlayer, targetPos, startCFrame)
    if not CONFIG.PredictionEnabled then return targetPos, 0 end
    local state = silentAimBuildState(targetPlayer)
    if not state then return targetPos, 0 end
    state.origin = startCFrame and startCFrame.Position or nil
    local mode = silentAimMode
    if not silentAimPredictors[mode] then mode = "VM" end
    local ok, result, lead = pcall(silentAimPredictors[mode], state, silentAimTune, targetPlayer,
        startCFrame and startCFrame.Position or Vector3.zero)
    if not ok or not result then return targetPos, 0 end
    silentAimLastLead = lead or 0
    return result, silentAimLastLead
end


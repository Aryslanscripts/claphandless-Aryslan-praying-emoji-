local function predictAt(s, lead)
    if s.sitting then return s.pos end

    -- Adaptive intent blend
    local blendBase = s.air and silentAimTune.intentBlendAir or silentAimTune.intentBlend
    local accelEffect = math.min(1, s.accelMag / 800) * silentAimTune.accelBoost
    local blend = math.clamp(blendBase - accelEffect, 0.15, 0.95)

    local intent = s.moveDir * (s.walkSpeed > 0 and s.walkSpeed or 16)
    local rawBlend = saFlat(s.vel):Lerp(saFlat(intent), blend)

    if s.player then
        local prev = saBlend[s.player]
        if prev then
            rawBlend = prev:Lerp(rawBlend, math.clamp(silentAimTune.blendSmooth, 0, 1))
        end
        saBlend[s.player] = rawBlend
    end

    -- Turn scaling
    local sc = math.clamp((s.turn - silentAimTune.turnGate)
        / math.max(0.001, 1 - silentAimTune.turnGate), 0, 1)
    local scale = (silentAimTune.straightScale or 1)
        + ((silentAimTune.turnScale or 1) - (silentAimTune.straightScale or 1)) * sc
    local hPred = rawBlend * lead * scale

    -- Vertical
    local g = workspace.Gravity
    local floorY = s.floorY and (s.floorY + (s.standHeight or 3))
                    or (s.pos.Y - silentAimTune.floorClamp)
    local jp = (s.jumpPower or 0) > 0 and s.jumpPower or 50
    local peak = jp * jp / 2 * g

    local y
    if not s.air then
        y = s.pos.Y
    elseif s.vel.Y > 0 then
        y = s.pos.Y + s.vel.Y * lead - 0.5 * g * silentAimTune.gravityScale * lead * lead
        y = math.max(y, floorY)
    elseif peak + silentAimTune.fallMargin < (s.pos.Y - floorY) then
        y = math.max(s.pos.Y + s.vel.Y * lead
            - 0.5 * g * silentAimTune.gravityScale * lead * lead, floorY)
    else
        y = floorY + silentAimTune.airAimHeight
    end

    return Vector3.new(s.pos.X + hPred.X, y + silentAimTune.yBias, s.pos.Z + hPred.Z)
end

silentAimPredictors.Dynamic = function(s, t)
    t = t or silentAimTune
    if s.sitting then return s.pos, 0 end

    local lead = computeLead()

    if not s.air then
        return predictAt(s, lead), lead
    end

    -- Multi-tau for air
    local n = silentAimTune.tauCount
    local spacing = silentAimTune.tauSpacing * silentAimTune.airTauBoost
    local sum, sumW = Vector3.zero, 0
    local half = (n - 1) / 2

    for i = 0, n - 1 do
        local k = (i - half) / half
        local tau = math.clamp(lead + k * spacing, t.leadMin, t.leadMax)
        local w = math.exp(-0.5 * (k * 1.2) ^ 2)
        sum += predictAt(s, tau) * w
        sumW += w
    end

    return sum / sumW, lead
end

silentAimPredictors.Piercer     = function(s, t) return silentAimPredictors.Dynamic(s, t) end
silentAimPredictors.FakeSheriff = function(s, t) return silentAimPredictors.Dynamic(s, t) end

-- Piercer origin (clamp-to-wall instead of nil-fallback)
local function silentAimPiercerOrigin(s, murdererChar)
    local avgDir = saAvgFleeDir(s.player)
    local dir = avgDir.Magnitude > 0.5 and avgDir or saSafeUnit(saFlat(s.vel))
    if dir.Magnitude < 0.5 then dir = saSafeUnit(saFlat(s.moveDir)) end
    if dir.Magnitude < 0.5 then return CFrame.new(s.pos) end

    local rawOrigin = s.pos - dir * silentAimPiercerBack

    if murdererChar then
        local myChar = LocalPlayer.Character
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { myChar, murdererChar }
        rp.IgnoreWater = true
        local hit = workspace:Raycast(rawOrigin, s.pos - rawOrigin, rp)
        if hit then
            rawOrigin = hit.Position + hit.Normal * 0.5
        end
    end

    return CFrame.new(rawOrigin)
end

local function silentAimExtend(fromPos, toPos)
    local n = toPos - fromPos
    if n.Magnitude <= 0.001 then return toPos end
    return fromPos + n + n.Unit * silentAimOvershoot
end

-- ============================================================
-- RESOLVE SHOT
-- ============================================================
local function silentAimResolveShot(targetPlayer, startCFrame)
    local state = silentAimBuildState(targetPlayer)
    if not state then return startCFrame, nil, nil end

    local mode = normalizeSilentAimType(silentAimMode)
    local pred = silentAimPredictors[mode] or silentAimPredictors.Dynamic

    local core, lead

    if isTargetFleeingFromMe(state) then
        local avgDir = saAvgFleeDir(state.player)
        if avgDir.Magnitude < 0.5 then avgDir = saSafeUnit(saFlat(state.vel)) end
        if avgDir.Magnitude < 0.5 then avgDir = saSafeUnit(saFlat(state.moveDir)) end
        local perp = Vector3.new(-avgDir.Z, 0, avgDir.X)
        core = state.pos
            + avgDir * FLEE_OFFSET_X
            + Vector3.new(0, FLEE_OFFSET_Y, 0)
            + perp * FLEE_OFFSET_Z
        lead = 0
    else
        core, lead = pred(state, silentAimTune)
    end

    silentAimState     = state
    silentAimStateTick = os.clock()
    silentAimLastLead  = lead or 0
    finalAimCore       = core
    PC.lastLead        = lead or 0

    if mode == "Piercer" then
        local murdererChar = targetPlayer and targetPlayer.Character
        local oCF = silentAimPiercerOrigin(state, murdererChar)
        return oCF, silentAimExtend(oCF.Position, core), core
    end

    if mode == "FakeSheriff" then
        local sheriffName, isVisible = checkAllPlayersVisibleMurderer(targetPlayer)
        if isVisible and sheriffName ~= "" then
            local sheriff = Players:FindFirstChild(sheriffName)
            if sheriff and sheriff ~= targetPlayer and sheriff ~= LocalPlayer then
                local sHRP = sheriff.Character and sheriff.Character:FindFirstChild(S.HRP)
                local tHRP = targetPlayer.Character and targetPlayer.Character:FindFirstChild(S.HRP)
                if sHRP and tHRP and (sHRP.Position - tHRP.Position).Magnitude > 3 then
                    local originPos = sHRP.Position
                    return CFrame.new(originPos),
                           silentAimExtend(originPos, core), core
                end
            end
        end
        return startCFrame, silentAimExtend(startCFrame.Position, core), core
    end

    return startCFrame, silentAimExtend(startCFrame.Position, core), core
end


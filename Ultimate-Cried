local function silentAimResolveShot(targetPlayer, startCFrame)
    local state = silentAimBuildState(targetPlayer)
    if not state then return startCFrame, nil, nil end

    local core, lead
    if isTargetFleeingFromMe(state) then
        local fleeDir = saFlat(state.vel)
        fleeDir = fleeDir.Magnitude > 1 and fleeDir.Unit or Vector3.zero
        local perp = Vector3.new(-fleeDir.Z, 0, fleeDir.X)
        core = state.pos
            + fleeDir * FLEE_OFFSET_X
            + Vector3.new(0, FLEE_OFFSET_Y, 0)
            + perp * FLEE_OFFSET_Z
        lead = 0
    else
        core, lead = silentAimPredictors.AutoPredict(state, silentAimTune)
    end

    silentAimLastLead = lead or 0
    return startCFrame, core, core
end

-- ============================================================
-- ANTI-TAMPER
-- ============================================================
local AT = { tampered = false, refs = {}, checks = 0, fails = 0 }

AT.refs.Dynamic     = silentAimPredictors.Dynamic
AT.refs.Adaptive    = silentAimPredictors.Adaptive
AT.refs.Full        = silentAimPredictors.Full
AT.refs.AutoPredict = silentAimPredictors.AutoPredict
AT.refs.BuildState  = silentAimBuildState
AT.refs.ResolveShot = silentAimResolveShot
AT.refs.WallBlocked = silentAimWallBlocked
AT.refs.SaFlat      = saFlat
AT.refs.SaSafeUnit  = saSafeUnit
AT.refs.FleeCheck   = isTargetFleeingFromMe

if type(getgenv) == "function" then
    pcall(function() getgenv()[S.ATKey] = S.Beacon end)
end

local function integrityCheck()
    if type(getgenv) == "function" then
        local ok = pcall(function() return getgenv()[S.ATKey] end)
        local v = ok and getgenv()[S.ATKey] or nil
        if v ~= S.Beacon then return false, "beacon" end
    end
    if silentAimPredictors.Dynamic     ~= AT.refs.Dynamic     then return false, "predDynamic" end
    if silentAimPredictors.Adaptive    ~= AT.refs.Adaptive    then return false, "predAdaptive" end
    if silentAimPredictors.Full        ~= AT.refs.Full        then return false, "predFull" end
    if silentAimPredictors.AutoPredict ~= AT.refs.AutoPredict then return false, "predAuto" end
    if silentAimBuildState             ~= AT.refs.BuildState  then return false, "buildState" end
    if silentAimResolveShot            ~= AT.refs.ResolveShot then return false, "resolve" end
    if silentAimWallBlocked            ~= AT.refs.WallBlocked then return false, "wall" end
    if saFlat                          ~= AT.refs.SaFlat      then return false, "saFlat" end
    if saSafeUnit                      ~= AT.refs.SaSafeUnit  then return false, "saSafeUnit" end
    if isTargetFleeingFromMe           ~= AT.refs.FleeCheck   then return false, "fleeCheck" end
    if type(silentAimTune.base) ~= "number" or silentAimTune.base < 0 or silentAimTune.base > 5 then return false, "base" end
    if type(silentAimTune.maxLead) ~= "number" or silentAimTune.maxLead < 0 or silentAimTune.maxLead > 5 then return false, "maxLead" end
    if type(silentAimTune.bulletSpeed) ~= "number" or silentAimTune.bulletSpeed <= 0 or silentAimTune.bulletSpeed > 1 then return false, "bulletSpeed" end
    if type(silentAimTune.localPingWeight) ~= "number" or silentAimTune.localPingWeight < 0 or silentAimTune.localPingWeight > 3 then return false, "localPingWeight" end
    if type(silentAimTune.targetPingWeight) ~= "number" or silentAimTune.targetPingWeight < 0 or silentAimTune.targetPingWeight > 3 then return false, "targetPingWeight" end
    return true
end

local function checkIntegrityNow()
    AT.checks = AT.checks + 1
    local ok, reason = integrityCheck()
    if not ok then
        AT.fails = AT.fails + 1
        AT.tampered = true
        return false, reason
    end
    return true
end
do
    local ok, reason = checkIntegrityNow()
    if not ok then warn("[AT] initial check failed: " .. tostring(reason)) end
end
task.spawn(function() while task.wait(2) do checkIntegrityNow() end end)


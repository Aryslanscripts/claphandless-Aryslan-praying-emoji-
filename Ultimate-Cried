-- VM Predictor wrapper
-- ============================================================
local vmPrediction = Prediction.new()
local vmContexts = {}

local function getVmCtx(player)
    local ctx = vmContexts[player]
    if not ctx then
        ctx = {
            Samples = {}, Bouts = {}, MoveSince = nil,
            Experts = nil, GroundAt = 0, Spoofed = false,
            Settings = { Aimbot = { Prediction = true } },
            AutoCal  = { Lead = 0 },
            Airborne = false, Gravity = 0, GroundY = nil,
            Vertical = { Velocity = 0, Gravity = 0, LandAt = nil },
            TurnRate = 0, TurnSamples = 0, TurnVariance = 0,
        }
        vmContexts[player] = ctx
    end
    return ctx
end

silentAimPredictors.VM = function(s, t, player, origin)
    if not player or not origin then
        return silentAimPredictors.Dynamic(s, t, player, origin)
    end
    local now = _clock()
    local ctx = getVmCtx(player)

    ctx.Settings.Aimbot.Prediction = CONFIG.PredictionEnabled
    local calib = targetCalib[player]
    ctx.AutoCal.Lead = calib and vclamp((calib.bias - 1) * 0.25, -0.1, 0.15) or 0

    ctx.Airborne = s.air
    ctx.Gravity  = workspace.Gravity
    ctx.GroundY  = s.floorY or (s.pos.Y - (s.standHeight or 3))
    if s.floorY then ctx.GroundAt = now end
    ctx.Vertical = {
        Velocity = s.vel.Y,
        Gravity  = -workspace.Gravity,
        LandAt   = (s.vel.Y > 0) and (now + 2 * s.vel.Y / workspace.Gravity) or nil,
    }

    ctx.TurnSamples = #ctx.Samples
    ctx.TurnRate, ctx.TurnVariance = 0, 0
    if #ctx.Samples >= 2 then
        local a = ctx.Samples[#ctx.Samples]
        local b = ctx.Samples[math.max(1, #ctx.Samples - 5)]
        if a and b then
            local dtAB = a.Time - b.Time
            if dtAB > 0.02 and a.Raw.Magnitude > 1 and b.Raw.Magnitude > 1 then
                ctx.TurnRate = math.acos(math.clamp(a.Raw.Unit:Dot(b.Raw.Unit), -1, 1)) / dtAB
            end
        end
        local angles = {}
        for i = math.max(1, #ctx.Samples - 8), #ctx.Samples do
            local smp = ctx.Samples[i]
            if smp and smp.Raw.Magnitude > 0.5 then
                angles[#angles+1] = math.atan2(smp.Raw.Z, smp.Raw.X)
            end
        end
        if #angles > 1 then
            local mean = 0
            for _, a in ipairs(angles) do mean = mean + a end
            mean = mean / #angles
            local var = 0
            for _, a in ipairs(angles) do var = var + (a - mean)*(a - mean) end
            ctx.TurnVariance = var / #angles
        end
    end

    table.insert(ctx.Samples, { Time = now, Raw = s.vel })
    while #ctx.Samples > 90 and (now - ctx.Samples[1].Time) > 1.5 do
        table.remove(ctx.Samples, 1)
    end

    if s.speed > 0.5 then ctx.MoveSince = ctx.MoveSince or now
    else ctx.MoveSince = nil end

    local okDT, dt = pcall(function()
        return vmPrediction:GetPredictionTime(ctx, now, LocalPlayer)
    end)
    if not okDT or type(dt) ~= "number" or dt <= 0 then
        return silentAimPredictors.Dynamic(s, t, player, origin)
    end

    local dir = s.pos - origin
    dir = dir.Magnitude > 1e-3 and dir.Unit or Vector3.new(0, 0, -1)
    vmPrediction.GroundY = ctx.GroundY

    local okP, J = pcall(function()
        return vmPrediction:PredictOffset(ctx, now, dt, origin, dir, s.vel, s.pos, nil, s.standHeight or 3)
    end)
    if not okP or typeof(J) ~= "Vector3" then
        return silentAimPredictors.Dynamic(s, t, player, origin)
    end

    local result = s.pos + J
    if t.yBias and t.yBias ~= 0 then result = result + Vector3.new(0, t.yBias, 0) end
    return result, dt
end


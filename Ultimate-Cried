-- ANTI-TAMPER
-- ============================================================
local AT = { tampered=false, refs={}, checks=0, fails=0 }
AT.refs.Simple   = silentAimPredictors.Simple
AT.refs.Dynamic  = silentAimPredictors.Dynamic
AT.refs.VM       = silentAimPredictors.VM
AT.refs.VMPred   = vmPrediction
AT.refs.VMTable  = vmContexts
AT.refs.Build    = silentAimBuildState
AT.refs.CalibHit = recordCalibHit
AT.refs.CalibMiss= recordCalibMiss
AT.refs.CalibTbl = targetCalib
AT.refs.ADV      = ADV
AT.refs.HOOK     = HOOK

if type(getgenv) == "function" then pcall(function() getgenv()[S.ATKey] = S.Beacon end) end

local function integrityCheck()
    if type(getgenv) == "function" then
        local ok = pcall(function() return getgenv()[S.ATKey] end)
        local v = ok and getgenv()[S.ATKey] or nil
        if v ~= S.Beacon then return false, "beacon" end
    end
    if silentAimPredictors.Simple  ~= AT.refs.Simple  then return false,"predSimple" end
    if silentAimPredictors.Dynamic ~= AT.refs.Dynamic then return false,"predDynamic" end
    if silentAimPredictors.VM      ~= AT.refs.VM      then return false,"predVM" end
    if vmPrediction                ~= AT.refs.VMPred  then return false,"vmPred" end
    if vmContexts                  ~= AT.refs.VMTable then return false,"vmTable" end
    if silentAimBuildState         ~= AT.refs.Build   then return false,"build" end
    if recordCalibHit              ~= AT.refs.CalibHit then return false,"calibHit" end
    if recordCalibMiss             ~= AT.refs.CalibMiss then return false,"calibMiss" end
    if targetCalib                 ~= AT.refs.CalibTbl then return false,"calibTbl" end
    if ADV                        ~= AT.refs.ADV     then return false,"adv" end
    if HOOK                       ~= AT.refs.HOOK    then return false,"hook" end
    if type(HOOK.enabled)~="boolean" then return false,"hookFields" end
    local modeOK = false
    for _,m in ipairs(SILENT_AIM_MODES) do if m==silentAimMode then modeOK=true; break end end
    if not modeOK then return false,"mode" end
    return true
end
local function checkIntegrityNow()
    AT.checks += 1
    local ok, reason = integrityCheck()
    if not ok then AT.fails += 1; AT.tampered = true; return false,reason end
    return true
end
do local ok,r = checkIntegrityNow(); if not ok then warn("[AT] "..tostring(r)) end end
task.spawn(function() while task.wait(2) do checkIntegrityNow() end end)


local pendingShots, pendingKills, totalShots, totalKills = 0, 0, 0, 0
local updateShotsBaseUI = nil
local function shotsBaseFlush()
    if pendingShots <= 0 and pendingKills <= 0 then return end
    local shots, kills = pendingShots, pendingKills
    pcall(function()
        local get = HttpService:RequestAsync({ Url = S.FB_URL .. S.FB_JSON_PATH, Method = S.FB_GET })
        local data = {}
        if get.Success and get.Body ~= S.FB_NULL and get.Body ~= "" then
            local ok, dec = pcall(HttpService.JSONDecode, HttpService, get.Body)
            if ok and type(dec) == "table" then data = dec end
        end
        local ns = (tonumber(data[S.FB_KEY_SHOTS]) or 0) + shots
        local nk = (tonumber(data[S.FB_KEY_KILLS]) or 0) + kills
        local put = HttpService:RequestAsync({
            Url = S.FB_URL .. S.FB_JSON_PATH, Method = S.FB_PUT,
            Headers = { [S.FB_CTYPE_KEY] = S.FB_CTYPE_VAL },
            Body = HttpService:JSONEncode({ [S.FB_KEY_SHOTS]=ns, [S.FB_KEY_KILLS]=nk }),
        })
        if put.Success then
            pendingShots -= shots; pendingKills -= kills
            totalShots, totalKills = ns, nk
            if updateShotsBaseUI then updateShotsBaseUI() end
        end
    end)
end
task.spawn(function() while true do task.wait(10); shotsBaseFlush() end end)
local function bumpShot() pendingShots += 1; if updateShotsBaseUI then updateShotsBaseUI() end end
local function bumpKill() pendingKills += 1; if updateShotsBaseUI then updateShotsBaseUI() end end


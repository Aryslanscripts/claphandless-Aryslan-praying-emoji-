-- ============================================================
-- HELPERS
-- ============================================================
local function saFlat(v) return Vector3.new(v.X,0,v.Z) end
local function saTurnBetween(a,b)
    if a.Magnitude < TURN_MIN_SPEED or b.Magnitude < TURN_MIN_SPEED then return 0 end
    return 1 - math.clamp(a.Unit:Dot(b.Unit), -1, 1)
end
local function saPushVelSample(p, vel)
    local now = os.clock(); local h = saHist[p] or {}; saHist[p] = h
    table.insert(h, {now, vel.X, vel.Y, vel.Z})
    while #h > 0 and now - h[1][1] > HIST_SPAN do table.remove(h,1) end
end
local function saVelAgo(p, ago)
    local h = saHist[p]; if not h or #h == 0 then return nil end
    local now = os.clock(); if TURN_WINDOW < now - h[#h][1] then return nil end
    local tgt = now - ago
    for i = #h,1,-1 do if h[i][1] <= tgt then return Vector3.new(h[i][2],h[i][3],h[i][4]) end end
    return Vector3.new(h[1][2],h[1][3],h[1][4])
end
local function countStrafeFlips(p, window)
    local h = saHist[p]; if not h or #h < 3 then return 0 end
    local now = os.clock(); local r = {}
    for i = #h,1,-1 do if now - h[i][1] > window then break end; table.insert(r,1,h[i]) end
    if #r < 3 then return 0 end
    local flips, lastDot = 0, nil
    for i = 2, #r do
        local v1 = Vector3.new(r[i-1][2],0,r[i-1][4])
        local v2 = Vector3.new(r[i][2],0,r[i][4])
        if v1.Magnitude > 2 and v2.Magnitude > 2 then
            local d = v1.Unit:Dot(v2.Unit)
            if lastDot and lastDot > 0.15 and d < -0.15 then flips += 1 end
            lastDot = d
        end
    end
    return flips
end

-- Ping
local PING_N = 12; local pingH, pingMeasured = {}, 0
local function sampleRawPing()
    local p = 0
    pcall(function() local v = LocalPlayer:GetNetworkPing()
        if type(v)=="number" and v==v and v>0 then p = v end end)
    pcall(function()
        local net = Stats and Stats.Network; local items = net and net.ServerStatsItem
        if items then for _, k in ipairs({"Data Ping","Ping"}) do
            local it = items[k]
            if it and it.GetValue then local v = it:GetValue()
                if type(v)=="number" and v==v and v>0 then p = math.max(p, v/1000) end end
        end end
    end)
    return p
end
task.spawn(function() while true do
    local s = sampleRawPing(); table.insert(pingH, s)
    if #pingH > PING_N then table.remove(pingH,1) end
    local sum,cnt = 0,0
    for _,v in ipairs(pingH) do if v>0 then sum+=v; cnt+=1 end end
    pingMeasured = cnt>0 and sum/cnt or 0
    task.wait(0.3)
end end)
local function getPingSafe() return pingMeasured > 0 and pingMeasured or sampleRawPing() end
local function getPingMs() return math.floor(getPingSafe()*1000 + 0.5) end

local function silentAimBuildState(player)
    local char = player and player.Character
    local hrp  = char and char:FindFirstChild(S.HRP)
    local hum  = char and char:FindFirstChildOfClass(S.Humanoid)
    if not (hrp and hum) then return nil end
    local vel = hrp.AssemblyLinearVelocity
    local jumpAge = os.clock() - (saLastJump[player] or 0)
    local ok, st = pcall(function() return hum:GetState() end)
    local stateAir = ok and (st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local filt = { char }; if LocalPlayer.Character then filt[2] = LocalPlayer.Character end
    rp.FilterDescendantsInstances = filt; rp.IgnoreWater = true
    local hit = workspace:Raycast(hrp.Position, Vector3.new(0,-80,0), rp)
    local velAgo = saVelAgo(player, TURN_WINDOW) or vel
    return {
        pos = hrp.Position, vel = vel, svel = saSmoothVel[player] or vel,
        accel = saSmoothAccel[player] or Vector3.zero,
        moveDir = hum.MoveDirection, walkSpeed = hum.WalkSpeed,
        jumpPower = hum.UseJumpPower and hum.JumpPower or (hum.JumpHeight*2*workspace.Gravity)^0.5,
        speed = saFlat(vel).Magnitude, speed3 = vel.Magnitude,
        turn = saTurnBetween(saFlat(vel), saFlat(velAgo)),
        accelMag = (saSmoothAccel[player] or Vector3.zero).Magnitude,
        jumpAge = jumpAge,
        air = stateAir or hum.FloorMaterial == Enum.Material.Air or jumpAge < 0.18,
        sitting = hum.Sit or hum.PlatformStand,
        strafing = hum.MoveDirection.Magnitude > 0.1,
        floorY = hit and hit.Position.Y or nil,
        standHeight = math.clamp(hum.HipHeight + hrp.Size.Y*0.5, 0.5, 8),
        ping = getPingSafe(),
    }
end


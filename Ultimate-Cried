local function normalizeSilentAimType(arg)
    if type(arg) ~= "string" then return "Dynamic" end
    if SILENT_AIM_LEGACY_MODES[arg] then return SILENT_AIM_LEGACY_MODES[arg] end
    for _, v in ipairs(SILENT_AIM_MODES) do if arg == v then return arg end end
    return "Dynamic"
end

local function saFlat(v) return Vector3.new(v.X, 0, v.Z) end
local function saSafeUnit(v) return v.Magnitude > 1e-4 and v.Unit or Vector3.zero end

local function saTurnBetween(a, b)
    if a.Magnitude < TURN_MIN_SPEED or b.Magnitude < TURN_MIN_SPEED then return 0 end
    return 1 - math.clamp(a.Unit:Dot(b.Unit), -1, 1)
end

local function saPushVelSample(player, vel)
    local now = os.clock()
    local h = saHist[player] or {}; saHist[player] = h
    table.insert(h, { now, vel })
    while #h > 0 and now - h[1][1] > HIST_SPAN do table.remove(h, 1) end
end

local function saVelAgo(player, ago)
    local h = saHist[player]
    if not h or #h == 0 then return nil end
    local now = os.clock()
    if TURN_WINDOW < now - h[#h][1] then return nil end
    local tgt = now - ago
    for i = #h, 1, -1 do
        if h[i][1] <= tgt then return h[i][2] end
    end
    return h[1][2]
end

local function saAvgFleeDir(player)
    local h = saFleeHist[player]
    if not h or #h == 0 then return Vector3.zero end
    local now = os.clock()
    local sum, count = Vector3.zero, 0
    for i = #h, 1, -1 do
        if now - h[i][1] > FLEE_AVG_WINDOW then break end
        sum += h[i][2]; count += 1
    end
    if count == 0 then return Vector3.zero end
    return saSafeUnit(sum / count)
end

local function saPushFleeSample(player, vel)
    local now = os.clock()
    local flat = saFlat(vel)
    if flat.Magnitude < 1 then return end
    local h = saFleeHist[player] or {}; saFleeHist[player] = h
    table.insert(h, { now, flat.Unit })
    while #h > 0 and now - h[1][1] > FLEE_AVG_WINDOW * 2 do table.remove(h, 1) end
end


local function getRawPing()
    local p = 0
    pcall(function()
        local net = StatsService and StatsService.Network
        local srv = net and net.ServerStatsItem
        local item = srv and srv["Data Ping"]
        if item and item.GetValue then
            local v = item:GetValue()
            if type(v) == "number" and v == v and v > 0 then p = v / 1000 end
        end
    end)
    if p == 0 then
        pcall(function()
            local v = LocalPlayer:GetNetworkPing()
            if type(v) == "number" and v == v then p = v end
        end)
    end
    return p
end

local function updatePing()
    local raw = getRawPing()
    if raw <= 0 then return end
    if PC.ping == 0 then PC.ping, PC.pingPrev = raw, raw; return end
    PC.pingPrev = PC.ping
    PC.ping = PC.ping * (1 - silentAimTune.pingEmaAlpha) + raw * silentAimTune.pingEmaAlpha
    PC.jitter = PC.jitter * 0.9 + math.abs(raw - PC.pingPrev) * 0.1
end

-- ============================================================
-- SERVER TICK AUTO-DETECT (safe pcall)
-- ============================================================
local pdTimestamps = {}
local function onPDChanged()
    table.insert(pdTimestamps, os.clock())
    if #pdTimestamps > 20 then table.remove(pdTimestamps, 1) end
    if #pdTimestamps < 5 then return end
    local diffs = {}
    for i = 2, #pdTimestamps do table.insert(diffs, pdTimestamps[i] - pdTimestamps[i-1]) end
    table.sort(diffs)
    local median = diffs[math.floor(#diffs/2)+1]
    if median and median > 0.001 and median < 1 then
        PC.serverTick = PC.serverTick * (1 - silentAimTune.serverTickAlpha)
                      + median * silentAimTune.serverTickAlpha
    end
end


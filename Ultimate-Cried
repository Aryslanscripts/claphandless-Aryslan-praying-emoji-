    f.Parent = notifGui
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke"); s.Color = color; s.Thickness = 1.5; s.Parent = f
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -12, 1, 0)
    l.Position = UDim2.new(0, 6, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = text; l.TextColor3 = color
    l.Font = Enum.Font.SourceSansBold; l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = f
    f:TweenPosition(UDim2.new(0.5, -110, 0, 12),
        Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
    task.delay(CONFIG.NotificationDuration, function()
        if f and f.Parent then
            f:TweenPosition(UDim2.new(0.5, -110, 0, -50),
                Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.25, true)
            task.wait(0.3); f:Destroy()
        end
    end)
end


    local l = Instance.new("TextLabel")
    l.Size, l.Position, l.BackgroundTransparency = UDim2.new(1,-12,1,0), UDim2.new(0,6,0,0), 1
    l.Text, l.TextColor3 = text, color
    l.Font, l.TextSize = Enum.Font.SourceSansBold, 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd; l.Parent = f

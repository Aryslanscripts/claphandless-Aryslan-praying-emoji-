local function registerHit(lead)
    PC.hits += 1
    PC.lastHitLead = lead
    PC.baseAdapt = math.max(silentAimTune.baseAdaptMin, PC.baseAdapt - 0.003)
end

local function registerMiss(lead)
    PC.misses += 1
    PC.lastMissLead = lead
    PC.baseAdapt = math.min(silentAimTune.baseAdaptMax,
        PC.baseAdapt + 0.005 * silentAimTune.baseAdaptSpeed / 0.3)
end

-- ============================================================
-- UNIFIED LEAD
-- ============================================================
local function computeLead()
    local rttHalf    = PC.ping / 2
    local tickHalf   = PC.serverTick / 2
    local jitterComp = PC.jitter * silentAimTune.jitterFactor
    local base       = silentAimTune.leadBase + PC.baseAdapt
    return math.clamp(rttHalf + tickHalf + jitterComp + base,
        silentAimTune.leadMin, silentAimTune.leadMax)
end


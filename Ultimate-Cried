local function getCalib(p)
    local c = targetCalib[p]; if not c then c = { bias=1.0, hits=0, misses=0 }; targetCalib[p] = c end
    return c
end
local function recordCalibHit(p)
    if not p then return end
    local c = getCalib(p); c.hits += 1
    c.bias = math.clamp(c.bias - ADV.calibHitStep, ADV.calibMin, ADV.calibMax)
end
local function recordCalibMiss(p)
    if not p then return end
    local c = getCalib(p); c.misses += 1
    c.bias = math.clamp(c.bias + ADV.calibMissStep, ADV.calibMin, ADV.calibMax)
end


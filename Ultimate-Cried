local PAD, ROW_H, STEP = 5, 16, 18
local function lbl(text, y, color)
    local l = Instance.new("TextLabel")
    l.Size, l.Position = UDim2.new(1,-PAD*2,0,14), UDim2.new(0,PAD,0,y)
    l.BackgroundTransparency = 1; l.Text = text
    l.TextColor3 = color or Color3.fromRGB(220,220,220)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Font, l.TextSize = Enum.Font.SourceSansBold, 10
    l.Parent = mini; return l
end
local function toggle(text, y, getter, setter)
    local b = Instance.new("TextButton")
    b.Size, b.Position = UDim2.new(1,-PAD*2,0,ROW_H), UDim2.new(0,PAD,0,y)
    b.BackgroundColor3 = getter() and Color3.fromRGB(60,140,80) or Color3.fromRGB(140,50,50)
    b.Text = text..": "..(getter() and "ON" or "OFF")
    b.TextColor3 = Color3.fromRGB(255,255,255)
    b.Font, b.TextSize = Enum.Font.SourceSansBold, 10
    b.Parent = mini
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,3)
    b.Activated:Connect(function()
        local ok, cur = pcall(getter); if not ok then return end
        pcall(setter, not cur)
        local ok2, nv = pcall(getter); if not ok2 then return end
        b.BackgroundColor3 = nv and Color3.fromRGB(60,140,80) or Color3.fromRGB(140,50,50)
        b.Text = text..": "..(nv and "ON" or "OFF")
    end)
end
local function adj(label, y, getter, setter, step, fmt)
    local l = Instance.new("TextLabel")
    l.Size, l.Position = UDim2.new(0.55,-PAD,0,ROW_H), UDim2.new(0,PAD,0,y)
    l.BackgroundTransparency = 1; l.Text = label
    l.TextColor3 = Color3.fromRGB(220,220,220)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Font, l.TextSize = Enum.Font.SourceSansBold, 10
    l.Parent = mini
    local v = Instance.new("TextLabel")
    v.Size, v.Position = UDim2.new(0,46,0,ROW_H), UDim2.new(1,-PAD-16*2-46-2,0,y)
    v.BackgroundColor3, v.Text, v.TextColor3 = Color3.fromRGB(35,35,35), fmt(getter()), Color3.fromRGB(255,220,100)
    v.Font, v.TextSize = Enum.Font.SourceSansBold, 9
    v.Parent = mini
    Instance.new("UICorner", v).CornerRadius = UDim.new(0,2)
    local function apply(d)
        local ok, cur = pcall(getter); if not ok or type(cur)~="number" then return end
        local nv = cur + d; if nv < 0 then nv = 0 end
        pcall(setter, nv)
        local ok2, nv2 = pcall(getter)
        if ok2 and type(nv2)=="number" then v.Text = fmt(nv2) end
    end
    local function mk(txt, xo, bg)
        local b = Instance.new("TextButton")
        b.Size, b.Position = UDim2.new(0,16,0,16), UDim2.new(1,-PAD+xo,0,y)
        b.BackgroundColor3, b.Text, b.TextColor3 = bg, txt, Color3.fromRGB(255,255,255)
        b.Font, b.TextSize = Enum.Font.SourceSansBold, 12
        b.Parent = mini
        Instance.new("UICorner", b).CornerRadius = UDim.new(0,2)
        return b
    end
    local mn = mk("−", -(16*2+2), Color3.fromRGB(100,40,40))
    local pl = mk("+", -16, Color3.fromRGB(40,100,60))
    mn.Activated:Connect(function() apply(-step) end)
    pl.Activated:Connect(function() apply( step) end)
end


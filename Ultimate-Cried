local silentAimPredictors = {}

-- AryslanHUB formula
silentAimPredictors.Simple = function(s, t, player, _origin)
    t = t or silentAimTune
    local char = player and player.Character
    if not char then return s.pos, 0 end
    local upperTorso = char:FindFirstChild(S.UpperTorso) or char:FindFirstChild(S.Torso) or char:FindFirstChild(S.HRP)
    local hum = char:FindFirstChildOfClass(S.Humanoid)
    if not upperTorso or not hum then return s.pos, 0 end
    local lead = t.simpleLead or 2.8
    return upperTorso.Position
        + upperTorso.AssemblyLinearVelocity * Vector3.new(0.75, 0.5, 0.75) * (lead / 15)
        + hum.MoveDirection * lead, lead
end

silentAimPredictors.Dynamic = function(s, t, player, _origin)
    t = t or silentAimTune
    if s.sitting then return s.pos, 0 end
    local n = s.ping*t.pingScale + t.base + t.serverLatency
    if s.air then n += t.airExtra end
    if t.turnGate < s.turn then n += s.turn*t.turnBoost end
    local baseLead = math.clamp(n, t.minLead, t.maxLead)
    local dist = s.origin and (s.pos - s.origin).Magnitude or 20
    local bulletTime = (t.bulletSpeed and t.bulletSpeed > 0) and dist*t.bulletSpeed or 0
    local maxMult = math.clamp(1 + dist/t.distanceMaxLeadScale, 1, t.distanceMaxLeadMult)
    local lead = math.min(baseLead, t.maxLead*maxMult) + bulletTime
    local strafeFlips = countStrafeFlips(player, t.strafeWindow)
    local strafeMul = (strafeFlips >= 2) and t.strafeLeadMult or 1
    local calib = (ADV.enabled and player and targetCalib[player]) and targetCalib[player].bias or 1
    local intent = s.moveDir * (s.walkSpeed > 0 and s.walkSpeed or 16)
    local ib = s.air and t.intentBlendAir or t.intentBlend
    local sc = math.clamp((s.turn - t.turnGate)/math.max(0.001, 1-t.turnGate), 0, 1)
    local hv = saFlat(s.vel):Lerp(saFlat(intent), ib)
    local hP = hv*lead*(t.straightScale + (t.turnScale-t.straightScale)*sc)*strafeMul*calib
    if ADV.enabled and t.accelWeight > 0 then
        local a = s.accel; local am = a.Magnitude
        if am > t.accelMaxMag then a = am>1e-6 and (a*(t.accelMaxMag/am)) or Vector3.zero end
        hP = hP + saFlat(a)*(0.5*lead*lead)*t.accelWeight*calib
    end
    local g = workspace.Gravity
    local floorY = s.floorY and (s.floorY + (s.standHeight or 3)) or (s.pos.Y - t.floorClamp)
    local y
    if not s.air then y = s.pos.Y
    else
        local jp = (s.jumpPower or 0) > 0 and s.jumpPower or 50
        local peak = jp*jp/2*g
        if peak + t.fallMargin < (s.pos.Y - floorY) then
            y = math.max(s.pos.Y + s.vel.Y*lead - 0.5*g*t.gravityScale*lead*lead, floorY)
        else y = floorY + t.airAimHeight end
    end
    if hv.Magnitude < t.minHorizSpeed and not s.air then
        return Vector3.new(s.pos.X, y + t.yBias, s.pos.Z), lead
    end
    return Vector3.new(s.pos.X+hP.X, y+t.yBias, s.pos.Z+hP.Z), lead
end


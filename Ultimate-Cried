local function adj(label, y, getter, setter, step, fmt)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0.55, -PAD, 0, ROW_H)
    l.Position = UDim2.new(0, PAD, 0, y)
    l.BackgroundTransparency = 1
    l.Text = label; l.TextColor3 = Color3.fromRGB(220,220,220)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Font = Enum.Font.SourceSansBold; l.TextSize = 10
    l.Parent = mini
    local v = Instance.new("TextLabel")
    v.Size = UDim2.new(0, 46, 0, ROW_H)
    v.Position = UDim2.new(1, -PAD - 16*2 - 46 - 2, 0, y)
    v.BackgroundColor3 = Color3.fromRGB(35,35,35)
    v.Text = fmt(getter()); v.TextColor3 = Color3.fromRGB(255,220,100)
    v.Font = Enum.Font.SourceSansBold; v.TextSize = 9
    v.Parent = mini
    Instance.new("UICorner", v).CornerRadius = UDim.new(0, 2)
    local function apply(delta)
        local ok, cur = pcall(getter)
        if not ok or type(cur) ~= "number" then return end
        local nv = cur + delta
        if nv < 0 then nv = 0 end
        pcall(setter, nv)
        local ok2, nv2 = pcall(getter)
        if ok2 and type(nv2) == "number" then v.Text = fmt(nv2) end
    end
    local function mk(txt, xoff, bg)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 16, 0, 16)
        b.Position = UDim2.new(1, -PAD + xoff, 0, y)
        b.BackgroundColor3 = bg
        b.Text = txt; b.TextColor3 = Color3.fromRGB(255,255,255)
        b.Font = Enum.Font.SourceSansBold; b.TextSize = 12
        b.Parent = mini
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 2)
        return b
    end
    local mn = mk("−", -(16*2 + 2), Color3.fromRGB(100,40,40))
    local pl = mk("+", -16, Color3.fromRGB(40,100,60))
    mn.Activated:Connect(function() apply(-step) end)
    pl.Activated:Connect(function() apply( step) end)
end


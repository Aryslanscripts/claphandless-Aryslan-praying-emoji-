    end)
end

local pendingTargets = {}
local function watchTargetDeath(tp)
    if not tp or pendingTargets[tp] then return end
    pendingTargets[tp] = true
    local t0 = os.clock(); local conn
    conn = RunService.Heartbeat:Connect(function()
        if not pendingTargets[tp] then if conn then conn:Disconnect() end; return end
        local c = tp.Character
        local h = c and c:FindFirstChildOfClass(S.Humanoid)
        if h and h.Health <= 0 then
            pendingTargets[tp] = nil; conn:Disconnect()
            recordCalibHit(tp); bumpKill()
            notify("Killed "..tp.DisplayName, Color3.fromRGB(60,200,90))
            return
        end
        if os.clock() - t0 > CONFIG.KillCheckTime then
            pendingTargets[tp] = nil; conn:Disconnect()
            recordCalibMiss(tp)
        end
    end)
end

-- ============================================================
-- GUN.ACTIVATED HOOK
-- ============================================================
local lastShotAt = 0

local function findShootRemote(gun)
    local direct = gun:FindFirstChild(CONFIG.ShootEventName)
    if direct and direct:IsA("RemoteEvent") then return direct end
    local kl = gun:FindFirstChild(S.KnifeLocal)
    if kl then
        local nested = kl:FindFirstChild(CONFIG.ShootEventName)
        if nested and nested:IsA("RemoteEvent") then return nested end
    end
    for _, d in ipairs(gun:GetDescendants()) do
        if d:IsA("RemoteEvent") and d.Name == CONFIG.ShootEventName then return d end
    end
    return nil
end

local function fireSilentShot(gun, murderer)
    if AT.tampered then return end
    if not HOOK.enabled then HOOK.lastMsg = "disabled"; return end
    if os.clock() - lastShotAt < CONFIG.Cooldown then return end
    lastShotAt = os.clock()

    local myChar = LocalPlayer.Character
    local myHand = myChar and (myChar:FindFirstChild(S.RightHand) or myChar:FindFirstChild(S.RightArm))
    if not myHand then HOOK.lastMsg = "no-hand"; return end

    local mChar = murderer and murderer.Character
    if not mChar then HOOK.lastMsg = "no-mchar"; return end
    local mHRP = mChar:FindFirstChild(S.HRP)
    if not mHRP then HOOK.lastMsg = "no-mhrp"; return end

    local shootRemote = findShootRemote(gun)
    if not shootRemote then HOOK.lastMsg = "no-remote"; return end

    local originCF = CFrame.new(myHand.Position)
    local aimPos = predictPosition(murderer, mHRP.Position, originCF)
    if not aimPos then HOOK.lastMsg = "predict-fail"; return end

    HOOK.shots += 1
    HOOK.lastMsg = "fired"
    bumpShot()
    pcall(function()
        shootRemote:FireServer(originCF, CFrame.new(aimPos))
    end)
    watchTargetDeath(murderer)
end

local function hookGun(gun)
    if gun:GetAttribute(S.KillHooked) then return end
    gun:SetAttribute(S.KillHooked, true)
    HOOK.hooked += 1

    if type(getconnections) == "function" then
        pcall(function()
            for _, conn in ipairs(getconnections(gun.Activated) or {}) do
                pcall(function()
                    if conn.Disable then conn:Disable()
                    elseif conn.Enabled ~= nil then conn.Enabled = false
                    elseif conn.Disconnect then conn:Disconnect()
                    end
                    HOOK.disabled += 1
                end)
            end
        end)
    end

    gun.Activated:Connect(function()
        local m = getMurderer()
        if m and m ~= LocalPlayer then
            fireSilentShot(gun, m)
        else
            HOOK.lastMsg = "no-murderer"
        end
    end)
end

local function bindCharacter(char)
    char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") and c.Name == CONFIG.GunName then hookGun(c) end
    end)
    local g = char:FindFirstChild(CONFIG.GunName)
    if g and g:IsA("Tool") then hookGun(g) end

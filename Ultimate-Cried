local AT = { tampered = false, refs = {} }
AT.refs.Dynamic     = silentAimPredictors.Dynamic
AT.refs.Piercer     = silentAimPredictors.Piercer
AT.refs.FakeSheriff = silentAimPredictors.FakeSheriff
AT.refs.BuildState  = silentAimBuildState
AT.refs.ResolveShot = silentAimResolveShot
AT.refs.WallBlocked = silentAimWallBlocked
AT.refs.Normalize   = normalizeSilentAimType
AT.refs.FleeCheck   = isTargetFleeingFromMe
AT.refs.CheckVisible= checkAllPlayersVisibleMurderer

if type(getgenv) == "function" then
    pcall(function() getgenv()[S.ATKey] = S.Beacon end)
end

local function integrityCheck()
    if type(getgenv) == "function" then
        local ok = pcall(function() return getgenv()[S.ATKey] end)
        local v = ok and getgenv()[S.ATKey] or nil
        if v ~= S.Beacon then return false end
    end
    if silentAimPredictors.Dynamic     ~= AT.refs.Dynamic     then return false end
    if silentAimPredictors.Piercer     ~= AT.refs.Piercer     then return false end
    if silentAimPredictors.FakeSheriff ~= AT.refs.FakeSheriff then return false end
    if silentAimBuildState             ~= AT.refs.BuildState  then return false end
    if silentAimResolveShot            ~= AT.refs.ResolveShot then return false end
    if silentAimWallBlocked            ~= AT.refs.WallBlocked then return false end
    if normalizeSilentAimType          ~= AT.refs.Normalize   then return false end
    if isTargetFleeingFromMe           ~= AT.refs.FleeCheck   then return false end
    if checkAllPlayersVisibleMurderer  ~= AT.refs.CheckVisible then return false end
    if type(silentAimTune.leadBase) ~= "number" or silentAimTune.leadBase < 0 or silentAimTune.leadBase > 5 then return false end
    if type(silentAimTune.leadMax)  ~= "number" or silentAimTune.leadMax  < 0 or silentAimTune.leadMax  > 5 then return false end
    if type(silentAimTune.serverTickDefault) ~= "number" or silentAimTune.serverTickDefault < 0 or silentAimTune.serverTickDefault > 0.5 then return false end
    local modeOK = false
    for _, m in ipairs(SILENT_AIM_MODES) do
        if m == silentAimMode then modeOK = true; break end
    end
    if not modeOK then return false end
    return true
end

local function checkAT()
    if not integrityCheck() then AT.tampered = true end
end
checkAT()
task.spawn(function() while task.wait(2) do checkAT() end end)


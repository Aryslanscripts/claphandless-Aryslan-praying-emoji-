-- ============================================================
-- SHOTS BASE
-- ============================================================
local pendingShots, pendingKills = 0, 0
local totalShots, totalKills = 0, 0
local updateShotsBaseUI = nil

local function shotsBaseFlush()
    if pendingShots <= 0 and pendingKills <= 0 then return end
    local shots, kills = pendingShots, pendingKills
    pcall(function()
        local get = HttpService:RequestAsync({ Url = S.FB_URL .. S.FB_JSON_PATH, Method = S.FB_GET })
        local data = {}
        if get.Success and get.Body ~= S.FB_NULL and get.Body ~= "" then
            local ok, decoded = pcall(HttpService.JSONDecode, HttpService, get.Body)
            if ok and type(decoded) == "table" then data = decoded end
        end
        local newShots = (tonumber(data[S.FB_KEY_SHOTS]) or 0) + shots
        local newKills = (tonumber(data[S.FB_KEY_KILLS]) or 0) + kills
        local put = HttpService:RequestAsync({
            Url = S.FB_URL .. S.FB_JSON_PATH, Method = S.FB_PUT,
            Headers = { [S.FB_CTYPE_KEY] = S.FB_CTYPE_VAL },
            Body = HttpService:JSONEncode({
                [S.FB_KEY_SHOTS] = newShots,
                [S.FB_KEY_KILLS] = newKills,
            }),
        })
        if put.Success then
            pendingShots = pendingShots - shots
            pendingKills = pendingKills - kills
            totalShots = newShots
            totalKills = newKills
            if updateShotsBaseUI then updateShotsBaseUI() end
        end
    end)
end

task.spawn(function() while true do task.wait(10); shotsBaseFlush() end end)

local function bumpShot() pendingShots = pendingShots + 1; if updateShotsBaseUI then updateShotsBaseUI() end end
local function bumpKill() pendingKills = pendingKills + 1; if updateShotsBaseUI then updateShotsBaseUI() end end


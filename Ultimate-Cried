-- GUN.ACTIVATED → SILENT SHOOT
-- ============================================================
local lastShot = 0

local function findShootRemote(gun)
    local direct = gun:FindFirstChild(CONFIG.ShootEventName)
    if direct and direct:IsA("RemoteEvent") then return direct end
    local kl = gun:FindFirstChild(S.KnifeLocal)
    if kl then
        local nested = kl:FindFirstChild(CONFIG.ShootEventName)
        if nested and nested:IsA("RemoteEvent") then return nested end
    end
    for _, d in ipairs(gun:GetDescendants()) do
        if d:IsA("RemoteEvent") and d.Name == CONFIG.ShootEventName then return d end
    end
    return nil
end

local function silentShoot(targetPlayer, gun)
    if AT.tampered then return false end
    if not targetPlayer or not gun then return false end
    if os.clock() - lastShot < CONFIG.Cooldown then return false end
    lastShot = os.clock()

    local tChar = targetPlayer.Character
    if not tChar then return false end
    local tHrp = tChar:FindFirstChild(S.HRP) or tChar:FindFirstChild(S.Head)
    local tHum = tChar:FindFirstChildOfClass(S.Humanoid)
    if not tHrp then return false end
    if tHum and tHum.Health <= 0 then return false end

    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local rh = myChar:FindFirstChild(S.RightHand) or myChar:FindFirstChild(S.RightArm)
    if not rh then return false end

    local shootEvent = findShootRemote(gun)
    if not shootEvent then return false end

    local startCF = CFrame.new(rh.Position)
    local aim, _, newOCF = predictPosition(targetPlayer, tHrp.Position, startCF)
    if not aim then return false end
    aim = aim + Vector3.new(0, 1.5, 0)

    if CONFIG.WallCheck then
        local originPos = newOCF and newOCF.Position or startCF.Position
        if silentAimWallBlocked(myChar, tChar, originPos, aim) then return false end
    end

    local mode = normalizeSilentAimType(silentAimMode)
    local originCF = (mode == "Piercer" and newOCF) or startCF

    bumpShot()
    task.spawn(function()
        pcall(function()
            shootEvent:FireServer(originCF, CFrame.new(aim))
        end)
    end)
    watchTargetDeath(targetPlayer)
    return true
end

local function hookGun(gun)
    if gun:GetAttribute(S.KillHooked) then return end
    gun:SetAttribute(S.KillHooked, true)
    gun.Activated:Connect(function()
        local m = getMurderer()
        if m and m ~= LocalPlayer then silentShoot(m, gun) end
    end)
end

local function bindCharacter(char)
    char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") and c.Name == CONFIG.GunName then hookGun(c) end
    end)
    local g = char:FindFirstChild(CONFIG.GunName)
    if g and g:IsA("Tool") then hookGun(g) end
end


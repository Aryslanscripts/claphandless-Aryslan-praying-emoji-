local CurrentRoundClient = nil
do
    local ok, r = pcall(function()
        local node = ReplicatedStorage
        for _, name in ipairs(CONFIG.RoundModulePath) do
            node = node:WaitForChild(name, 10)
            if not node then error("Не найден: " .. name) end
        end
        return require(node)
    end)
    if ok and r then CurrentRoundClient = r
    else warn("[Kill] CurrentRoundClient НЕ загрузился") end
end

local function getMurderer()
    if not CurrentRoundClient then return nil end
    local ok, m = pcall(function()
        local pd = CurrentRoundClient.PlayerData
        if not pd or not next(pd) then return nil end
        for name, data in pairs(pd) do
            if data and data.Role == "Murderer" then return Players:FindFirstChild(name) end
        end
    end)
    return (ok and m) or nil
end

-- ============================================================
-- HEARTBEAT
-- ============================================================
RunService.Heartbeat:Connect(function()
    local now = os.clock()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = p.Character
        if not c then continue end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local vel = hrp.AssemblyLinearVelocity

        local old = saSmoothVel[p]
        if old then
            local dt = now - (saLastTick[p] or now)
            if dt > 1e-3 then
                local a = math.clamp(dt / 0.10, 0, 1)
                local nv = old:Lerp(vel, a)
                saSmoothAccel[p] = (nv - old) / dt
                saSmoothVel[p] = nv
            end
        else
            saSmoothVel[p] = vel; saSmoothAccel[p] = Vector3.zero
        end
        saLastTick[p] = now
        saPushVelSample(p, vel)

        local hum = c:FindFirstChildOfClass("Humanoid")
        if hum then
            local ok, st = pcall(function() return hum:GetState() end)
            if ok and (st == Enum.HumanoidStateType.Jumping
                    or st == Enum.HumanoidStateType.Freefall) then
                local prev = saLastJump[p]
                if not prev or (now - prev) > 0.15 then saLastJump[p] = now end
            end
        end
    end
end)

local function shouldPredict(targetPlayer)
    if not CONFIG.PredictionEnabled then return false end
    local mode = CONFIG.MoveMode
    if mode == "Never"  then return false end
    if mode == "Always" then return true end
    local myC = LocalPlayer.Character
    local myH = myC and myC:FindFirstChild("HumanoidRootPart")
    local tC  = targetPlayer.Character
    local tH  = tC and tC:FindFirstChild("HumanoidRootPart")
    if not myH or not tH then return false end
    local d = (myH.Position - tH.Position).Magnitude
    local thr = CONFIG.MoveDistance
    if mode == "GreaterThan" then return d >= thr end
    if mode == "LessThan"    then return d <= thr end
    if mode == "Near"        then return math.abs(d - thr) <= CONFIG.MoveTolerance end
    return false
end

local function predictPosition(targetPlayer, targetPos, startCFrame)
    if not shouldPredict(targetPlayer) then return targetPos, 0, nil end
    local origin = startCFrame or CFrame.new(LocalPlayer.Character.HumanoidRootPart.Position)
    local newOCF, aim, lead = silentAimResolveShot(targetPlayer, origin)
    if not aim then return targetPos, 0, nil end
    local off = CONFIG.ShootOffset
    if off.X ~= 0 or off.Y ~= 0 or off.Z ~= 0 then
        local myH = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist = myH and (myH.Position - targetPos).Magnitude or 10
        if dist < 5 then dist = 5 end
        aim = aim + Vector3.new(off.X/100*dist, off.Y/100*dist, off.Z/100*dist)
    end
    return aim, lead, newOCF
end

-- ============================================================
-- SHOOT REMOTE / FIRE
-- ============================================================
local function findShootRemote(gun)
    local direct = gun:FindFirstChild(CONFIG.ShootEventName)
    if direct and direct:IsA("RemoteEvent") then return direct end
    local kl = gun:FindFirstChild("KnifeLocal")
    if kl then
        local nested = kl:FindFirstChild(CONFIG.ShootEventName)
        if nested and nested:IsA("RemoteEvent") then return nested end
    end
    for _, d in ipairs(gun:GetDescendants()) do
        if d:IsA("RemoteEvent") and d.Name == CONFIG.ShootEventName then return d end
    end
    for _, d in ipairs(gun:GetDescendants()) do
        if d:IsA("RemoteEvent") and d.Name:lower():find("shoot", 1, true) then return d end
    end
    return nil
end

-- forward decl (notify определён ниже)
local notify

local pendingKills = {}
local function watchTargetDeath(tp)
    if pendingKills[tp] then return end
    pendingKills[tp] = true
    local t0 = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not pendingKills[tp] then if conn then conn:Disconnect() end; return end
        local c = tp.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h and h.Health <= 0 then
            pendingKills[tp] = nil; conn:Disconnect()
            notify("Killed " .. tp.DisplayName, Color3.fromRGB(60, 200, 90))
            return
        end
        if os.clock() - t0 > CONFIG.KillCheckTime then
            pendingKills[tp] = nil; conn:Disconnect()
        end
    end)
end

local lastShot = 0

local function silentShoot(targetPlayer, gun)
    if not targetPlayer or not gun then return false end
    if os.clock() - lastShot < CONFIG.Cooldown then return false end
    lastShot = os.clock()

    local tChar = targetPlayer.Character
    local tHrp  = tChar and (tChar:FindFirstChild("HumanoidRootPart")
                          or tChar:FindFirstChild("Head"))
    if not tHrp then return false end
    local hum = tChar:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end

    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local rh = myChar:FindFirstChild("RightHand") or myChar:FindFirstChild("Right Arm")
    local startPos = rh and rh.Position or myChar:GetPivot().Position
    local startCF  = CFrame.new(startPos)

    local shootEvent = findShootRemote(gun)
    if not shootEvent then warn("[Kill] Shoot не найден!"); return false end

    local aim, _, newOCF = predictPosition(targetPlayer, tHrp.Position, startCF)
    if newOCF then startCF = newOCF end
    aim = aim + Vector3.new(0, 1.5, 0)

    task.spawn(function()
        pcall(function()
            shootEvent:FireServer(startCF, CFrame.new(aim))
        end)
    end)

    watchTargetDeath(targetPlayer)
    return true
end

-- ============================================================
-- HOOK: Gun.Activated → silent aim shoot. Без auto-equip.
-- ============================================================
local function hookGun(gun)
    if gun:GetAttribute("KillHooked") then return end
    gun:SetAttribute("KillHooked", true)
    gun.Activated:Connect(function()
        local m = getMurderer()
        if m and m ~= LocalPlayer then
            silentShoot(m, gun)
        end
    end)
end

local function bindCharacter(char)
    char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") and c.Name == CONFIG.GunName then
            hookGun(c)
        end
    end)
    local g = char:FindFirstChild(CONFIG.GunName)
    if g and g:IsA("Tool") then hookGun(g) end
end

if LocalPlayer.Character then bindCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(bindCharacter)


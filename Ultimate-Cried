local TURN_WINDOW, TURN_MIN_SPEED, HIST_SPAN = 0.12, 1.5, 1.0

local FLEE_OFFSET_X, FLEE_OFFSET_Y, FLEE_OFFSET_Z = 2.0, 1.0, 0.0
local FLEE_MIN_SPEED, FLEE_MIN_DISTANCE, FLEE_DOT_THRESHOLD = 4.0, 8.0, 0.55
local FAKE_SH_SIGHT_RANGE, FAKE_SH_FOV_DOT = 300, 0.30

local silentAimState, silentAimStateTick, silentAimLastLead = nil, 0, 0
local finalAimCore = Vector3.zero
local saHist, saSmoothVel, saSmoothAccel, saLastJump, saLastTick = {}, {}, {}, {}, {}

-- ============================================================
-- HELPERS
-- ============================================================
local function normalizeSilentAimType(arg)
    if type(arg) ~= "string" then return "Dynamic" end
    if SILENT_AIM_LEGACY_MODES[arg] then return SILENT_AIM_LEGACY_MODES[arg] end
    for _, v in ipairs(SILENT_AIM_MODES) do if arg == v then return arg end end
    return "Dynamic"
end
local function saFlat(v) return Vector3.new(v.X,0,v.Z) end
local function saSafeUnit(v) return v.Magnitude > 1e-4 and v.Unit or Vector3.zero end
local function saTurnBetween(a,b)
    if a.Magnitude < TURN_MIN_SPEED or b.Magnitude < TURN_MIN_SPEED then return 0 end
    return 1 - math.clamp(a.Unit:Dot(b.Unit), -1, 1)
end
local function saPushVelSample(player, vel)
    local now = os.clock()
    local h = saHist[player] or {}; saHist[player] = h
    table.insert(h, {now, vel.X, vel.Y, vel.Z})
    while #h > 0 and now - h[1][1] > HIST_SPAN do table.remove(h,1) end
end
local function saVelAgo(player, ago)
    local h = saHist[player]; if not h or #h == 0 then return nil end
    local now = os.clock(); if TURN_WINDOW < now - h[#h][1] then return nil end
    local tgt = now - ago
    for i = #h,1,-1 do
        if h[i][1] <= tgt then return Vector3.new(h[i][2],h[i][3],h[i][4]) end
    end
    return Vector3.new(h[1][2],h[1][3],h[1][4])
end
local function getPingSafe()
    local p = 0
    pcall(function()
        local v = LocalPlayer:GetNetworkPing()
        if type(v) == "number" and v == v then p = v end
    end)
    return p
end

local function silentAimBuildState(player)
    local char = player and player.Character
    local hrp  = char and char:FindFirstChild(S.HRP)
    local hum  = char and char:FindFirstChildOfClass(S.Humanoid)
    if not (hrp and hum) then return nil end
    local vel = hrp.AssemblyLinearVelocity
    local jumpAge = os.clock() - (saLastJump[player] or 0)
    local ok, st = pcall(function() return hum:GetState() end)
    local stateAir = ok and (st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local filt = { char }; if LocalPlayer.Character then filt[2] = LocalPlayer.Character end
    rp.FilterDescendantsInstances = filt; rp.IgnoreWater = true
    local hit = workspace:Raycast(hrp.Position, Vector3.new(0,-80,0), rp)
    local velAgo = saVelAgo(player, TURN_WINDOW) or vel
    return {
        pos = hrp.Position, vel = vel,
        svel = saSmoothVel[player] or vel,
        accel = saSmoothAccel[player] or Vector3.zero,
        moveDir = hum.MoveDirection, walkSpeed = hum.WalkSpeed,
        jumpPower = hum.UseJumpPower and hum.JumpPower or (hum.JumpHeight*2*workspace.Gravity)^0.5,
        speed = saFlat(vel).Magnitude, speed3 = vel.Magnitude,
        turn = saTurnBetween(saFlat(vel), saFlat(velAgo)),
        accelMag = (saSmoothAccel[player] or Vector3.zero).Magnitude,
        jumpAge = jumpAge,
        air = stateAir or hum.FloorMaterial == Enum.Material.Air or jumpAge < 0.18,
        sitting = hum.Sit or hum.PlatformStand,
        strafing = hum.MoveDirection.Magnitude > 0.1,
        floorY = hit and hit.Position.Y or nil,
        standHeight = math.clamp(hum.HipHeight + hrp.Size.Y*0.5, 0.5, 8),
        ping = getPingSafe(),
    }
end

local function isTargetFleeingFromMe(state)
    if FLEE_OFFSET_X <= 0 then return false end
    local myChar = LocalPlayer.Character; if not myChar then return false end
    local myHrp = myChar:FindFirstChild(S.HRP); if not myHrp then return false end
    local vel = saFlat(state.vel); if vel.Magnitude < FLEE_MIN_SPEED then return false end
    local toMe = saFlat(myHrp.Position - state.pos)
    if toMe.Magnitude < FLEE_MIN_DISTANCE then return false end
    return vel.Unit:Dot(toMe.Unit) < -FLEE_DOT_THRESHOLD
end

local function checkAllPlayersVisibleMurderer(target)
    if not target then return "", false end
    local targetChar = target.Character; if not targetChar then return "", false end
    local targetHRP = targetChar:FindFirstChild(S.HRP) or targetChar:FindFirstChild(S.Head)
    local targetHum = targetChar:FindFirstChildOfClass(S.Humanoid)
    if not targetHRP then return "", false end
    if targetHum and targetHum.Health <= 0 then return "", false end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude; rp.IgnoreWater = true
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or p == target then continue end
        local char = p.Character; if not char then continue end
        local hrp = char:FindFirstChild(S.HRP)
        local head = char:FindFirstChild(S.Head)
        local hum = char:FindFirstChildOfClass(S.Humanoid)
        if not hrp or not hum or hum.Health <= 0 then continue end
        local eye = head or hrp
        local toTarget = targetHRP.Position - eye.Position
        local dist = toTarget.Magnitude
        if dist < 1 or dist > FAKE_SH_SIGHT_RANGE then continue end
        if hrp.CFrame.LookVector:Dot(toTarget.Unit) < FAKE_SH_FOV_DOT then continue end
        rp.FilterDescendantsInstances = { char, targetChar }
        local hit = workspace:Raycast(eye.Position, toTarget, rp)
        if not hit or hit.Instance:IsDescendantOf(targetChar) then return p.Name, true end
    end
    return "", false
end

local silentAimPredictors = {}

silentAimPredictors.Dynamic = function(s, t)
    t = t or silentAimTune
    if s.sitting then return s.pos, 0 end
    local n = s.ping*t.pingScale + t.base
    if s.air then n += t.airExtra end
    if t.turnGate < s.turn then n += s.turn*t.turnBoost end
    local lead = math.clamp(n, t.minLead, t.maxLead)
    local intent = s.moveDir * (s.walkSpeed > 0 and s.walkSpeed or 16)
    local ib = s.air and t.intentBlendAir or t.intentBlend
    local sc = math.clamp((s.turn - t.turnGate) / math.max(0.001, 1 - t.turnGate), 0, 1)
    local hP = saFlat(s.vel):Lerp(saFlat(intent), ib) * lead
        * (t.straightScale + (t.turnScale - t.straightScale) * sc)
    local g = workspace.Gravity
    local floorY = s.floorY and (s.floorY + (s.standHeight or 3)) or (s.pos.Y - t.floorClamp)
    local jp = (s.jumpPower or 0) > 0 and s.jumpPower or 50
    local peak = jp*jp/2*g
    local y
    if not s.air then
        y = s.pos.Y
    elseif peak + t.fallMargin < (s.pos.Y - floorY) then
        y = math.max(s.pos.Y + s.vel.Y*lead - 0.5*g*t.gravityScale*lead*lead, floorY)
    else
        y = floorY + t.airAimHeight
    end
    return Vector3.new(s.pos.X + hP.X, y + t.yBias, s.pos.Z + hP.Z), lead
end

silentAimPredictors.Piercer = function(s, t) return silentAimPredictors.Dynamic(s, t) end
silentAimPredictors.FakeSheriff = function(s, t) return silentAimPredictors.Dynamic(s, t) end

local function silentAimPiercerOrigin(s)
    local v = saFlat(s.vel); if v.Magnitude < 1 then v = saFlat(s.moveDir) end
    return CFrame.new(s.pos - saSafeUnit(v) * silentAimPiercerBack)
end
local function silentAimExtend(fromPos, toPos)
    local n = toPos - fromPos
    if n.Magnitude <= 0.001 then return toPos end
    return fromPos + n + n.Unit * silentAimOvershoot
end

local function silentAimWallBlocked(myChar, murdererChar, fromPos, toPos)
    local delta = toPos - fromPos
    if delta.Magnitude < 0.001 then return false, nil end
    local filter = { myChar }
    if murdererChar then table.insert(filter, murdererChar) end
    for _, v in ipairs(CollectionService:GetTagged(S.PassThrough)) do
        table.insert(filter, v)
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    params.IgnoreWater = true
    for _ = 1, 12 do
        local hit = workspace:Raycast(fromPos, delta, params)
        if not hit then return false, nil end
        if murdererChar and hit.Instance:IsDescendantOf(murdererChar) then return false, nil end
        if hit.Instance.Transparency ~= 1 then
            return true, hit.Instance:GetFullName()
        end
        table.insert(filter, hit.Instance)
        params.FilterDescendantsInstances = filter
    end
    return false, nil
end

local function silentAimResolveShot(targetPlayer, startCFrame)
    local state = silentAimBuildState(targetPlayer)
    if not state then return startCFrame, nil, nil end
    local mode = normalizeSilentAimType(silentAimMode)
    local pred = silentAimPredictors[mode] or silentAimPredictors.Dynamic
    local core, lead
    if isTargetFleeingFromMe(state) then
        local fleeDir = saFlat(state.vel)
        fleeDir = fleeDir.Magnitude > 1 and fleeDir.Unit or Vector3.zero
        local perp = Vector3.new(-fleeDir.Z, 0, fleeDir.X)
        core = state.pos
            + fleeDir * FLEE_OFFSET_X
            + Vector3.new(0, FLEE_OFFSET_Y, 0)
            + perp * FLEE_OFFSET_Z
        lead = 0
    else
        core, lead = pred(state, silentAimTune)
    end
    silentAimState     = state
    silentAimStateTick = os.clock()
    silentAimLastLead  = lead or 0
    finalAimCore       = core

    if mode == "Piercer" then
        local oCF = silentAimPiercerOrigin(state)
        return oCF, silentAimExtend(oCF.Position, core), core
    end
    if mode == "FakeSheriff" then
        local sheriffName, isVisible = checkAllPlayersVisibleMurderer(targetPlayer)
        if isVisible and sheriffName ~= "" then
            local sheriff = Players:FindFirstChild(sheriffName)
            local sheriffHRP = sheriff and sheriff.Character and sheriff.Character:FindFirstChild(S.HRP)
            if sheriffHRP then
                local originPos = sheriffHRP.Position
                return CFrame.new(originPos), silentAimExtend(originPos, core), core
            end
        end
        return startCFrame, silentAimExtend(startCFrame.Position, core), core
    end
    return startCFrame, silentAimExtend(startCFrame.Position, core), core
end


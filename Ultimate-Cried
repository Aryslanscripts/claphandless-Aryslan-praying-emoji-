local Vec = Vector3.new
local vclamp = math.clamp
local _sqrt, _abs, _sin, _cos = math.sqrt, math.abs, math.sin, math.cos
local _atan2, _floor, _ceil, _exp = math.atan2, math.floor, math.ceil, math.exp
local _clock, _HUGE = os.clock, 1/0

local Prediction = {}
Prediction.__index = Prediction

local Ping = { Value=0, Echo=nil, EchoAt=0, EchoPing=0, NextAt=0 }
local function ServerPing()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and type(v)=="number" and v>0 and v<2000 then return v/1000 end
end
local function ClientPing(prov)
    if not prov or not prov.GetNetworkPing then return nil end
    local ok, p = pcall(prov.GetNetworkPing, prov)
    if ok and type(p)=="number" and p>=0 and p<2 then return p end
end

function Prediction:GetRoundTrip(t, prov)
    t = t or _clock()
    if t >= Ping.NextAt then
        Ping.NextAt = t + 0.25
        local v = ServerPing() or ClientPing(prov)
        if v then Ping.Value = Ping.Value + (v - Ping.Value) * 0.35 end
    end
    if Ping.Echo and (t - Ping.EchoAt) < 90 then
        return vclamp(Ping.Echo + (Ping.Value - Ping.EchoPing), 0, 0.6)
    end
    return vclamp(Ping.Value, 0, 0.6)
end
function Prediction:SetEcho(value, echoPing, t)
    Ping.Echo = value; Ping.EchoPing = echoPing or 0; Ping.EchoAt = t or _clock()
end

Prediction.InterpolationBase  = 0.12
Prediction.InterpolationScale = 0.60
Prediction.InterpolationDelay = 0.15
Prediction.MaxPredictionTime  = 0.8

function Prediction:GetPredictionTime(ctx, t, prov)
    if ctx.Settings and ctx.Settings.Aimbot and ctx.Settings.Aimbot.Prediction == false then
        return 0
    end
    local lead = vclamp((ctx.AutoCal and ctx.AutoCal.Lead) or 0, -0.1, 0.15)
    local rtt  = self:GetRoundTrip(t, prov)
    self.InterpolationDelay = vclamp(self.InterpolationBase + self.InterpolationScale * rtt, 0.05, 0.35)
    return vclamp(rtt + self.InterpolationDelay + lead, 0, self.MaxPredictionTime)
end

function Prediction:PredictPath(origin, direction, v, gravity, dt, hh)
    if dt <= 0 then return Vec(0,0,0), nil end
    local g   = gravity or 0
    local arc = Vec(v.X*dt, v.Y*dt - 0.5*g*dt*dt, v.Z*dt)
    local groundY = self.GroundY
    if groundY then
        local feet = origin.Y + arc.Y - (hh or 2.1)
        if feet < groundY - 0.3 and _abs(origin.Y - groundY) < 8 then
            return Vec(arc.X, groundY - origin.Y + (hh or 2.1), arc.Z), groundY
        end
    end
    return arc, nil
end

function Prediction:VerticalPlan(ctx, now, dt, gravity, hh)
    local v   = ctx.Vertical or {}
    local vy  = (v.Velocity or 0) + (v.Gravity or 0) * dt
    local landed = v.LandAt ~= nil and (now + dt) >= v.LandAt
    if landed then vy = 0 end
    return vy, (ctx.Airborne and vy > 0) or landed, landed
end

function Prediction:OscillationOffset(ctx, now, dt)
    local o = ctx.Oscillation
    if not o or not o.Period or o.Period <= 0 then return nil end
    local ph  = ((now + dt) / o.Period) * 2 * math.pi
    local amp = o.Amplitude or 0
    local x, z = _cos(ph) * amp, _sin(ph) * amp
    if o.Axis then return Vec(x * o.Axis.X, 0, z * o.Axis.Z) end
    return Vec(x, 0, z)
end

function Prediction:SnapToGround(pos, window) return pos end
function Prediction:IsTargetGrounded(pos) return true end
function Prediction:Noise(x, y, amp, freq) return math.noise(x * freq, y * freq, 0) * amp end
function Prediction:ObserverPosition()
    local cam = Workspace.CurrentCamera
    return cam and cam.CFrame.Position or nil
end

function Prediction:PredictOffset(ctx, now, dt, origin, dir, velocity, targetPos, _, hh)
    local GRAV_MAX, TURN_LIMIT, SPEED_LIMIT, TURN_SAMPLE_MIN = 500, 0.8, 6, 6
    local TURN_VAR_MAX_SQ, TURN_THETA_CLAMP = 0.5, 2.5
    local LAND_WINDOW, LAND_Y_TOL, GROUND_PEN = 1, 8, 0.3
    local PERP_MIN, KERNEL_S2, KERNEL_POW = 1, 0.6, 3
    local SCORE_HYST, REC_INTERVAL, PENDING_MAX = 0.04, 1/60, 90

    -- 5.1 turn-arc
    local gravity = ctx.Airborne and vclamp(ctx.Gravity or 0, 0, GRAV_MAX) or 0
    local turn = vclamp(ctx.TurnRate or 0, -12, 12)
    local speed = velocity.Magnitude
    if _abs(turn) > TURN_LIMIT and speed > SPEED_LIMIT
       and (ctx.TurnSamples or 0) >= TURN_SAMPLE_MIN
       and not ctx.Oscillation and not ctx.Jitter
       and _sqrt(vclamp(ctx.TurnVariance or 0, 0, 200)) < TURN_VAR_MAX_SQ * _abs(turn) + 0.5
       and dt > 0 then
        local theta = vclamp(turn * dt, -TURN_THETA_CLAMP, TURN_THETA_CLAMP)
        local a = _sin(theta) / turn
        local b = (1 - _cos(theta)) / turn
        local f = velocity.Unit
        local s = Vec(-f.Z, 0, f.X)
        local m = (f * a + s * b) * (speed / dt)
        velocity = Vec(m.X, velocity.Y, m.Z)
    end

    -- 5.2 ballistic + snap
    local arc, groundY = self:PredictPath(origin, dir, velocity, gravity, dt, hh)
    local Rg = ctx.GroundY
    if Rg and groundY and (now - (ctx.GroundAt or 0)) < LAND_WINDOW
       and _abs(targetPos.Y - Rg) < LAND_Y_TOL
       and targetPos.Y + arc.Y < Rg - GROUND_PEN then
        arc = Vec(arc.X, Rg - targetPos.Y, arc.Z)
    end

    -- 5.3 vertical plan
    local vy, flag, landed = self:VerticalPlan(ctx, now, dt, vclamp(ctx.Gravity or 196.2, 1, 500), hh)
    if landed then arc = Vec(arc.X, vy, arc.Z)
    elseif vy > 0 then arc = arc + Vec(0, vy, 0) end

    -- 5.4 lift
    local lift = ctx.Lift
    if lift and lift.Period and dt > 0 and self:IsTargetGrounded(targetPos) then
        local period = _ceil(dt / lift.Period)
        local tau = (now + dt - period * lift.Period - lift.Start) * 40
        local idx = _floor(tau)
        local y
        if idx + 1 >= #lift.Values then
            local last = lift.Values[#lift.Values]
            local startLast = lift.Start + (#lift.Values - 1) / 40
            y = last + (lift.LastY - last) * vclamp(
                (now + dt - period * lift.Period - startLast)
                / math.max(lift.LastTime - startLast, 1e-4), 0, 1)
        elseif idx >= 0 then
            y = lift.Values[idx+1] + (lift.Values[idx+2] - lift.Values[idx+1]) * (tau - idx)
        end
        if y then
            arc = Vec(arc.X, y - targetPos.Y, arc.Z)
            flag = self:Noise(0, 0, 0.35 + lift.Error * 1.5, vclamp(hh, 0.5, 4))
        end
    end

    -- 5.5 oscillation + jitter
    local osc = self:OscillationOffset(ctx, now, dt)
    if osc then arc = Vec(osc.X, arc.Y, osc.Z) end
    if ctx.Jitter and self:IsTargetGrounded(ctx.MeanOffset) then
        arc = arc + ctx.MeanOffset
    end
    if dt <= 0 then return arc, flag end
    if not self:IsTargetGrounded(targetPos) then return arc, flag end

    -- 5.6 ensemble bootstrap
    local experts = ctx.Experts
    if not experts then
        experts = {
            Scores = { Model=0.56, Raw=0.50, Turn=0.48, Accel=0.47, Center=0.45 },
            Pending = {}, Choice = "Model", Final = 0.5, ChanceAvg = 0.5,
            Scored = 0, ScoredAt = now, RecordAt = -_HUGE,
        }
        ctx.Experts = experts
    end

    local R = Vec(targetPos.X, 0, targetPos.Z)
    local points = { Model = R + arc }

    local samples = ctx.Samples or {}
    local last = samples[#samples]
    local rawVel = last and last.Raw
    if rawVel and not ctx.Spoofed then points.Raw = R + rawVel * dt end

    local old
    for i = #samples - 1, 1, -1 do
        if now - samples[i].Time >= 0.09 then old = samples[i]; break end
    end
    if old and old.Raw and rawVel then
        local dtOld = now - old.Time
        if old.Raw.Magnitude > 4 and rawVel.Magnitude > 4 then
            points.Accel = points.Raw + (rawVel - old.Raw) * (0.35 * dt * dt / dtOld)
            local f0 = _atan2(rawVel.Z, rawVel.X)
            local f1 = _atan2(old.Raw.Z, old.Raw.X)
            local dth = ((f1 - f0 + math.pi) % (2*math.pi)) - math.pi
            local om = dth / dtOld
            if _abs(om) > 0.3 then
                local m = rawVel.Magnitude
                points.Turn = R + Vec(
                    _sin(f0 + om*dt) - _sin(f0), 0,
                    _cos(f0) - _cos(f0 + om*dt)
                ) * (m / om)
            end
        end
    end
    points.Turn = points.Turn or points.Raw
    points.Accel = points.Accel or points.Raw

    -- 5.7 bout detector
    local bouts = ctx.Bouts
    if ctx.MoveSince and bouts and #bouts >= 3 then
        local elapsed = now - ctx.MoveSince
        local w = math.max(0.35, 1 / math.max((points.Raw or points.Model - R).Magnitude, 0.01))
        local best, bestT = -1, 1
        for _, bt in ipairs(bouts) do
            if bt > elapsed then
                local t = math.min(bt - elapsed, dt) / dt
                local cnt = (_abs(1 - t) <= w) and 1 or 0
                for _, bt2 in ipairs(bouts) do
                    if bt2 > elapsed and _abs(math.min(bt2 - elapsed, dt)/dt - t) <= w then
                        cnt = cnt + 1
                    end
                end
                if cnt > best + 0.01 then best, bestT = cnt, t end
            end
        end
        local total = 1
        for _, bt in ipairs(bouts) do
            if bt > elapsed and _abs(math.min(bt - elapsed, dt)/dt - 1) <= w then
                total = total + 1
            end
        end
        local y = bestT < 0.999 and bestT or 1
        ctx.BoutHit = math.max(best, (total >= best + 0.01) and 1 or 0) / total
        if y < 0.999 then
            for k, v in pairs(points) do points[k] = R + (v - R) * y end
        end
        ctx.BoutFactor = y
    else
        ctx.BoutFactor = 1
        ctx.BoutHit = nil
    end

    -- 5.8 center
    local snap = self:SnapToGround(targetPos, 0.3)
    if snap then points.Center = Vec(snap.X, 0, snap.Z) end

    -- 5.9 score-based choice
    local scores = experts.Scores
    local choice = points[experts.Choice] and experts.Choice or "Model"
    local best = scores[choice] + SCORE_HYST
    for name in pairs(points) do
        if scores[name] > best then best, choice = scores[name], name end
    end
    experts.Choice = choice
    local final = points[choice]

    -- 5.10 kernel blend
    local obs = self:ObserverPosition()
    local perp = obs and Vec(-(R.Z - obs.Z), 0, R.X - obs.X) or nil
    if perp and perp.Magnitude > PERP_MIN then
        local d = perp.Unit
        local bestS, bestP = -1, final
        for _, p1 in pairs(points) do
            local s = 0
            for _, p2 in pairs(points) do
                local d1 = (p1 - p2):Dot(d)
                s = s + scores[p2]^KERNEL_POW * _exp(-d1*d1 / KERNEL_S2)
            end
            if s > bestS then bestS, bestP = s, p1 end
        end
        for _, p1 in pairs(points) do
            local mid = (p1 + final) * 0.5
            local s = 0
            for _, p2 in pairs(points) do
                local d1 = (mid - p2):Dot(d)
                s = s + scores[p2]^KERNEL_POW * _exp(-d1*d1 / KERNEL_S2)
            end
            if s > bestS then bestS, bestP = s, mid end
        end
        final = bestP
    end

    -- 5.11 final offset
    local J = Vec(final.X - R.X, arc.Y, final.Z - R.Z)

    -- 5.12 record for calibration
    if now - experts.RecordAt >= REC_INTERVAL then
        experts.RecordAt = now
        local rec = {
            Due = now + dt, Time = now, Points = points, Final = final,
            FinalY = targetPos.Y + J.Y, HalfHeight = vclamp(hh, 0.5, 4), Observer = obs,
        }
        table.insert(experts.Pending, rec)
        if #experts.Pending > PENDING_MAX then table.remove(experts.Pending, 1) end
        experts.LastRecord = rec
    end
    return J, flag
end

function Prediction:CalibrateScore(ctx, score, boutHit)
    local ex = ctx.Experts
    if not ex then return score end
    local last = ex.LastRecord
    if last and not last.Chance then last.Chance = score end
    if ctx.MoveSince and boutHit then
        score = score * vclamp(0.55 + 0.45 * boutHit, 0, 1)
    end
    local scored    = vclamp(ex.Scored / 60, 0, 1)
    local chanceAvg = vclamp((ex.Final + 0.03) / (ex.ChanceAvg + 0.03), 0.2, 1.05)
    return vclamp(score * (1 + (chanceAvg - 1) * scored), 0, 1)
end

function Prediction.new(opts)
    local self = setmetatable({}, Prediction)
    if opts then
        self.GroundY = opts.GroundY
        self.InterpolationBase  = opts.InterpolationBase  or self.InterpolationBase
        self.InterpolationScale = opts.InterpolationScale or self.InterpolationScale
    end
    return self
end

